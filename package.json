{
  "name": "focus",
  "version": "1.3.0",
  "description": "A macOS menu-bar app that locks every screen during sleep hours, Screen Time style.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --mac",
    "install:local": "scripts/install-local.sh"
  },
  "author": "Rohit Singhal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rosinghal/focus.git"
  },
  "homepage": "https://github.com/rosinghal/focus#readme",
  "bugs": {
    "url": "https://github.com/rosinghal/focus/issues"
  },
  "os": [
    "darwin"
  ],
  "type": "commonjs",
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "productName": "Focus",
  "build": {
    "appId": "com.focus.app",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "extendInfo": {
        "LSUIElement": true
      }
    }
  },
  "dependencies": {
    "baileys": "7.0.0-rc14",
    "qrcode": "1.5.4"
  }
}
